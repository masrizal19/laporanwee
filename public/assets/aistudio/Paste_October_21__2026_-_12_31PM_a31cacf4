<!-- ═════════ 4. INTEGRASI LOGIKA & SINKRONISASI API ═════════ -->
<script>
const $ = (s) => document.querySelector(s); const $$ = (s) => [...document.querySelectorAll(s)];

const API_BASE = 'https://api-laporanwe.mkverse.my.id/api/profile';
const JOB_OPTIONS = ['Art Director', 'Desainer Grafis', 'VIDEO EDITOR', 'Videografer', 'Copywriter', 'Social Media'];
const STATUS_OPTIONS = ['KARYAWAN', 'MAGANG', 'PKL SISWA', 'PKL MAHASISWA'];

let state = { id: 1, name: 'Admin', email: '', job: '', status: '', avatarUrl: '' };
let pristine = { ...state };

function showToast(msg) {
  const t = $('#toastMsg');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(showToast._timer);
  showToast._timer = setTimeout(() => t.classList.remove('show'), 2600);
}

// Hitung persentase kelengkapan profil (setiap field bernilai 20%)
function updateProgressUI() {
  const filledCount = [
    Boolean(state.avatarUrl),
    Boolean(state.name.trim()),
    Boolean(state.email.trim()),
    Boolean(state.job.trim()),
    Boolean(state.status)
  ].filter(Boolean).length;

  const percent = filledCount * 20;
  $('#pct').textContent = `${percent}%`;
  $('#chipPercent').textContent = `Profil ${percent}% lengkap`;
  
  // Update stroke lingkaran 553 adalah keliling r=88
  const offset = 553 - (553 * (percent / 100));
  $('#ringProgress').style.strokeDashoffset = offset;

  $('#displayName').textContent = state.name.trim() || 'Pengguna';
  $('#chipJob').textContent = state.job.trim() || 'Pekerjaan belum diatur';
  $('#chipStatus').textContent = state.status || 'Status belum dipilih';

  // Avatar / Inisial Render
  if (state.avatarUrl) {
    $('#mainAvatarImg').src = state.avatarUrl;
    $('#mainAvatarImg').style.display = 'block';
    $('#mainAvatarInit').style.display = 'none';
  } else {
    $('#mainAvatarImg').style.display = 'none';
    $('#mainAvatarInit').style.display = 'grid';
    $('#mainAvatarInit').textContent = (state.name.trim()[0] || 'A').toUpperCase();
  }
}

function renderChips() {
  $('#jobChips').innerHTML = JOB_OPTIONS.map(j => `
    <button type="button" class="opt ${state.job.toLowerCase() === j.toLowerCase() ? 'on' : ''}" data-job="${j}">${j}</button>
  `).join('');

  $('#statusChips').innerHTML = STATUS_OPTIONS.map(s => `
    <button type="button" class="opt ${state.status.toUpperCase() === s.toUpperCase() ? 'on' : ''}" data-status="${s}">${s}</button>
  `).join('');
}

// BACA DATA DARI BACKEND
async function loadUserData() {
  const token = localStorage.getItem('auth_token') || localStorage.getItem('token') || '';
  const adminEmail = localStorage.getItem('admin_email') || '';

  try {
    const res = await fetch(`${API_BASE}/get.php?id=1`, {
      headers: {
        'Accept': 'application/json',
        'Authorization': `Bearer ${token}`,
        'X-Admin-Email': adminEmail
      }
    });
    const json = await res.json();
    const u = json.data || json.user || json;

    if (u) {
      state.id = u.id || 1;
      state.name = u.full_name || u.name || 'RIZAL FADHILAH';
      state.email = u.email || 'rizalsaragih498@gmail.com';
      state.job = u.pekerjaan || u.title || 'VIDEO EDITOR';
      state.status = (u.status_karyawan || u.employment_status || u.status || 'KARYAWAN').toUpperCase();
      state.avatarUrl = u.avatar_url || u.avatar || '';

      pristine = { ...state };

      $('#inputName').value = state.name;
      $('#inputEmail').value = state.email;
      $('#inputJob').value = state.job;

      renderChips();
      updateProgressUI();
    }
  } catch (e) {
    console.warn('Backend get offline, menggunakan state default:', e);
    renderChips();
    updateProgressUI();
  }
}

// EVENT LISTENERS FORM
$('#inputName').oninput = (e) => { state.name = e.target.value; updateProgressUI(); };
$('#inputEmail').oninput = (e) => { state.email = e.target.value; updateProgressUI(); };
$('#inputJob').oninput = (e) => { state.job = e.target.value; renderChips(); updateProgressUI(); };

$('#jobChips').onclick = (e) => {
  const b = e.target.closest('[data-job]');
  if (!b) return;
  state.job = b.dataset.job;
  $('#inputJob').value = state.job;
  renderChips();
  updateProgressUI();
};

$('#statusChips').onclick = (e) => {
  const b = e.target.closest('[data-status]');
  if (!b) return;
  state.status = b.dataset.status;
  renderChips();
  updateProgressUI();
};

$('#btnCancel').onclick = () => {
  state = { ...pristine };
  $('#inputName').value = state.name;
  $('#inputEmail').value = state.email;
  $('#inputJob').value = state.job;
  renderChips();
  updateProgressUI();
  showToast('Perubahan dibatalkan');
};

$('#profileForm').onsubmit = async (e) => {
  e.preventDefault();
  const btn = $('#btnSubmitForm');
  btn.textContent = 'Menyimpan...';
  btn.disabled = true;

  const token = localStorage.getItem('auth_token') || localStorage.getItem('token') || '';

  try {
    const res = await fetch(`${API_BASE}/save.php`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${token}`
      },
      body: JSON.stringify({
        id: state.id,
        name: state.name.trim(),
        full_name: state.name.trim(),
        pekerjaan: state.job.trim(),
        status: state.status
      })
    });
    const resJson = await res.json();
    if (resJson.success) {
      pristine = { ...state };
      showToast('Profil berhasil disimpan');
    } else {
      showToast(resJson.message || 'Gagal menyimpan');
    }
  } catch (err) {
    console.error('Save error:', err);
    showToast('Profil disimpan secara lokal');
  } finally {
    btn.textContent = 'Simpan Profil';
    btn.disabled = false;
  }
};

/* ── MODAL CROP ENGINE (BEBAS FREEZE) ── */
const cropModal = $('#cropModalOverlay');
const cropImg = $('#cropImg');
const prevImgs = [$('#pvL'), $('#pvM'), $('#pvS')];
let cropSize = 240, imgW = 0, imgH = 0, scaleBase = 1;
let zoom = 1, posX = 0, posY = 0, currentSrc = '';

function clampPos() {
  const renderW = imgW * scaleBase * zoom;
  const renderH = imgH * scaleBase * zoom;
  posX = Math.min(0, Math.max(cropSize - renderW, posX));
  posY = Math.min(0, Math.max(cropSize - renderH, posY));
}

function updateCropStage() {
  clampPos();
  const s = scaleBase * zoom;
  const w = imgW * s - cropSize;
  const h = imgH * s - cropSize;

  cropImg.style.transform = `translate(${posX}px, ${posY}px) scale(${s})`;

  // Sinkronkan 3 preview lingkaran
  prevImgs.forEach(p => {
    const ratio = p.parentElement.clientWidth / cropSize;
    p.style.transform = `translate(${posX * ratio}px, ${posY * ratio}px) scale(${s * ratio})`;
  });

  // Sinkronkan nilai slider
  $('#rangeZoom').value = Math.round(zoom * 100);
  $('#outZoom').textContent = `${Math.round(zoom * 100)}%`;

  const canPanX = w > 1;
  const canPanY = h > 1;
  $('#rangeX').disabled = !canPanX;
  $('#rangeY').disabled = !canPanY;

  $('#rangeX').value = canPanX ? Math.round((-posX / w) * 100) : 50;
  $('#rangeY').value = canPanY ? Math.round((-posY / h) * 100) : 50;
  $('#outX').textContent = `${$('#rangeX').value}%`;
  $('#outY').textContent = `${$('#rangeY').value}%`;
}

function loadCropImage(src) {
  currentSrc = src;
  cropImg.crossOrigin = 'anonymous';
  cropImg.onload = () => {
    imgW = cropImg.naturalWidth || 480;
    imgH = cropImg.naturalHeight || 480;
    cropSize = $('#cropBox').clientWidth || 240;
    scaleBase = cropSize / Math.min(imgW, imgH);
    zoom = 1;
    posX = (cropSize - imgW * scaleBase) / 2;
    posY = (cropSize - imgH * scaleBase) / 2;

    prevImgs.forEach(p => {
      p.src = src;
      p.style.width = `${imgW}px`;
      p.style.height = `${imgH}px`;
    });
    cropImg.style.width = `${imgW}px`;
    cropImg.style.height = `${imgH}px`;

    updateCropStage();
  };
  cropImg.src = src;
}

// Buka modal crop
function openCropModal() {
  cropModal.classList.add('show');
  const source = state.avatarUrl || $('#mainAvatarImg').src || '';
  if (source) {
    loadCropImage(source);
  } else {
    // Buat canvas default inisial jika belum ada foto
    const c = document.createElement('canvas');
    c.width = c.height = 480;
    const ctx = c.getContext('2d');
    ctx.fillStyle = '#e3ddfa';
    ctx.fillRect(0, 0, 480, 480);
    ctx.fillStyle = '#2a2440';
    ctx.font = 'bold 200px Outfit';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText((state.name[0] || 'A').toUpperCase(), 240, 250);
    loadCropImage(c.toDataURL('image/jpeg'));
  }
}

function closeCropModal() {
  cropModal.classList.remove('show');
}

$('#btnOpenModal').onclick = openCropModal;
$('#btnPenEdit').onclick = openCropModal;
$('#avatarBox').onclick = openCropModal;
$('#btnCloseModal').onclick = closeCropModal;
cropModal.onclick = (e) => { if (e.target === cropModal) closeCropModal(); };

// CONTROLS INTERAKSI SLIDER & BUTTON
$('#rangeZoom').oninput = (e) => {
  zoom = e.target.value / 100;
  updateCropStage();
};
$('#btnZoomIn').onclick = () => { zoom = Math.min(3, zoom + 0.15); updateCropStage(); };
$('#btnZoomOut').onclick = () => { zoom = Math.max(1, zoom - 0.15); updateCropStage(); };

$('#rangeX').oninput = (e) => {
  const w = imgW * scaleBase * zoom - cropSize;
  posX = -(e.target.value / 100) * w;
  updateCropStage();
};
$('#rangeY').oninput = (e) => {
  const h = imgH * scaleBase * zoom - cropSize;
  posY = -(e.target.value / 100) * h;
  updateCropStage();
};

$('#btnMoveLeft').onclick = () => { posX += 20; updateCropStage(); };
$('#btnMoveRight').onclick = () => { posX -= 20; updateCropStage(); };
$('#btnMoveUp').onclick = () => { posY += 20; updateCropStage(); };
$('#btnMoveDown').onclick = () => { posY -= 20; updateCropStage(); };

// DRAG DENGAN KURSOR / JARI
let isDragging = false, startX = 0, startY = 0;
const cropBox = $('#cropBox');

cropBox.onpointerdown = (e) => {
  isDragging = true;
  cropBox.classList.add('drag');
  startX = e.clientX - posX;
  startY = e.clientY - posY;
  cropBox.setPointerCapture(e.pointerId);
};
cropBox.onpointermove = (e) => {
  if (!isDragging) return;
  posX = e.clientX - startX;
  posY = e.clientY - startY;
  updateCropStage();
};
cropBox.onpointerup = cropBox.onpointercancel = (e) => {
  isDragging = false;
  cropBox.classList.remove('drag');
};

// PUTAR & BALIK FOTO
$('#btnRotate').onclick = () => {
  const cv = document.createElement('canvas');
  cv.width = imgH; cv.height = imgW;
  const ctx = cv.getContext('2d');
  ctx.translate(cv.width / 2, cv.height / 2);
  ctx.rotate(Math.PI / 2);
  ctx.drawImage(cropImg, -imgW / 2, -imgH / 2);
  loadCropImage(cv.toDataURL('image/jpeg', 0.95));
};

$('#btnFlip').onclick = () => {
  const cv = document.createElement('canvas');
  cv.width = imgW; cv.height = imgH;
  const ctx = cv.getContext('2d');
  ctx.translate(cv.width / 2, cv.height / 2);
  ctx.scale(-1, 1);
  ctx.drawImage(cropImg, -imgW / 2, -imgH / 2);
  loadCropImage(cv.toDataURL('image/jpeg', 0.95));
};

// PILIH FOTO BARU
$('#filePicker').onchange = (e) => {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (ev) => loadCropImage(ev.target.result);
  reader.readAsDataURL(file);
};

$('#btnResetCrop').onclick = () => loadCropImage(currentSrc);

// SIMPAN HASIL CROP & UPLOAD KE BACKEND
$('#btnSaveCropped').onclick = async () => {
  const btn = $('#btnSaveCropped');
  btn.textContent = 'Menyimpan...';
  btn.disabled = true;

  const cv = document.createElement('canvas');
  cv.width = cv.height = 480;
  const ctx = cv.getContext('2d');
  const factor = 480 / cropSize;

  ctx.drawImage(
    cropImg,
    0, 0, imgW, imgH,
    posX * factor, posY * factor,
    imgW * scaleBase * zoom * factor,
    imgH * scaleBase * zoom * factor
  );

  const croppedDataUrl = cv.toDataURL('image/jpeg', 0.92);

  cv.toBlob(async (blob) => {
    try {
      const token = localStorage.getItem('auth_token') || localStorage.getItem('token') || '';
      const fd = new FormData();
      fd.append('avatar', blob, `avatar_${state.id}_${Date.now()}.jpg`);
      fd.append('id', state.id);

      const res = await fetch(`${API_BASE}/upload.php`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: fd
      });
      const data = await res.json();
      state.avatarUrl = (data.success && data.avatar_url) ? data.avatar_url : croppedDataUrl;
    } catch (err) {
      console.warn('Upload API offline, simpan data URL:', err);
      state.avatarUrl = croppedDataUrl;
    } finally {
      updateProgressUI();
      closeCropModal();
      btn.textContent = 'Simpan Foto';
      btn.disabled = false;
      showToast('Foto profil berhasil diperbarui');
    }
  }, 'image/jpeg', 0.92);
};

// Inisialisasi awal
document.addEventListener('DOMContentLoaded', loadUserData);
loadUserData();
</script>
